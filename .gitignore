# 凭据 —— 绝不提交
.env
*.key

# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.venv

# 官方游戏源码: 由 SDK 用自己的 API key 下载, 不随仓库分发
environment_files/

# 第三方参考仓(Tycho / duck-harness / just-explore / 官方 agent 模板), 各有各的许可
reference/

# 运行日志与中间产物
*.log
*.npy
.DS_Store

# harness 跑测产物
harness_runs/

# 例外: results/ 是实验证据存档, 跑测日志在这里破例入库, 见 results/README.md
!results/**

# Kaggle 本地运行产物
out/
recordings/
# Duck 本地运行目录里的源码快照/pickle/视频: 体积大且可再生
probes/**/duck_runs/*/src/
probes/**/duck_runs/*/*.pkl
probes/**/duck_runs/*/movies/
probes/**/duck_runs/*/solver_analysis/
probes/**/home_*/profiles/
probes/**/home_*/.anonymous-user-id

# 08-26 起: Duck 本地/Kaggle 运行目录只入库 transcripts + benchmark/summary/run_config, 其余可再生或体积大
probes/**/src/
probes/**/*.pkl
probes/**/movies/
