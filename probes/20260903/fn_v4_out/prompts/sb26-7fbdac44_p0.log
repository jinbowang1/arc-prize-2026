def cfg(f=current_frame):
    g=f.ascii.split('\n'); return {k:g[r][c] for k,(r,c) in POS.items()}
def swaps(cur,tgt):
    # cur,tgt dicts slot->color ; plan swaps to realize tgt
    plan=[]
    cur=dict(cur)
    for s in tgt:
        if cur[s]==tgt[s]: continue
        # find slot holding needed color
        src=[t for t in cur if cur[t]==tgt[s]][0]
        plan.append((src,s))
        cur[src],cur[s]=cur[s],cur[src]
    return plan
def run(plan):
    for src,dst in plan:
        action([{'action':'MOUSE','row':POS[src][0],'col':POS[src][1]}])
        r=action([{'action':'MOUSE','row':POS[dst][0],'col':POS[dst][1]}])
        if r['level_completed'] or r.get('done') or r.get('run_complete'): return True,r
    return False,last_action_result
