import collections
def kshape(f):
    a=f.ascii.split('\n')
    P=sorted((r,c) for r in range(15,26) for c in range(16,50) if a[r][c] in 'Sb')
    if not P: return None
    rs=[p[0] for p in P]; cs=[p[1] for p in P]
    grid=[''.join(a[r][c] for c in range(min(cs),max(cs)+1)) for r in range(min(rs),max(rs)+1)]
    return (min(rs),max(rs),min(cs),max(cs),len(P),grid)
