+def parse_prompt_log(text: str) -> tuple[dict[str, str], list[dict[str, str]]]:
+    """Split a rendered prompt-log snapshot into header fields and messages.
+
+    Each message is {"role", "content", "reasoning"}; role is lowercase and
+    tool results are folded into role "tool". Only the [MODEL INPUT] section is
+    parsed; the trailing turn transcript is ignored.
+    """
+    header: dict[str, str] = {}
+    start = text.find(PROMPT_LOG_INPUT_MARKER)
+    if start < 0:
+        return header, []
+    for line in text[:start].splitlines():
+        key, sep, value = line.partition(":")
+        if sep and key and " " not in key.strip():
+            header[key.strip()] = value.strip()
+    body = text[start + len(PROMPT_LOG_INPUT_MARKER):]
+    end = body.find("\n" + PROMPT_LOG_TRANSCRIPT_MARKER)
+    if end >= 0:
+        body = body[:end]
+    messages: list[dict[str, str]] = []
+    current: dict[str, Any] | None = None
+    target = "content"
+    for line in body.splitlines():
+        match = PROMPT_LOG_MESSAGE_HEADER_RE.match(line)
+        if match:
+            role = match.group(1).lower()
+            if role.startswith("tool result:"):
+                role = "tool"
+            current = {"role": role, "content": [], "reasoning": []}
+            messages.append(current)
+            target = "content"
+            continue
+        if current is None:
+            continue
+        sub = PROMPT_LOG_SUBBLOCK_RE.match(line)
+        if sub:
+            target = "reasoning" if sub.group(1) == "REASONING" else "skip"
+            continue
+        if target != "skip":
+            current[target].append(line)
+    return header, [
+        {
+            "role": str(message["role"]),
+            "content": "\n".join(message["content"]).strip(),
+            "reasoning": "\n".join(message["reasoning"]).strip(),
+        }
+        for message in messages
+    ]
+
