def norm(s):
    if not s: return frozenset()
    a=min(p[0] for p in s); b=min(p[1] for p in s)
    return frozenset((r-a,c-b) for r,c in s)
def tr(s,k,refl):
    t=s
    if refl:
        C=max(p[1] for p in t)+1; t=frozenset((r,C-1-c) for r,c in t)
    for _ in range(k):
        R=max(p[0] for p in t)+1; t=frozenset((c,R-1-r) for r,c in t)
